@model HabitacionFormularioViewModel
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="mb-3">
    <label asp-for="Numero" class="form-label"></label>
    <input asp-for="Numero" type="number" min="1" class="form-control" />
    <span asp-validation-for="Numero" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Tipo" class="form-label"></label>
    <input asp-for="Tipo" type="text" class="form-control" />
    <span asp-validation-for="Tipo" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Precio" class="form-label"></label>
    <input asp-for="Precio" type="number" step="0.01" min="0.01" class="form-control" />
    <span asp-validation-for="Precio" class="text-danger"></span>
</div>

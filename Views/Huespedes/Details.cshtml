@model Huesped

@{
    ViewData["Title"] = "Detalle del huésped";
}

<h1>Detalle del huésped</h1>

<dl class="row">
    <dt class="col-sm-3">Nombre</dt>
    <dd class="col-sm-9">@Model.NombreHuesped</dd>

    <dt class="col-sm-3">Celular</dt>
    <dd class="col-sm-9">@Model.Celular</dd>
</dl>

<a class="btn btn-primary"
   asp-action="Edit"
   asp-route-id="@Model.IdHuesped">
    Editar
</a>

<a class="btn btn-outline-secondary" asp-action="Index">
    Volver al listado
</a>
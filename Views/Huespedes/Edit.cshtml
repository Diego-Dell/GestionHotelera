@model HuespedFormularioViewModel

@{
    ViewData["Title"] = "Editar huésped";
}

<h1>Editar huésped</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit"
              asp-route-id="@Model.IdHuesped"
              method="post">

            <input type="hidden" asp-for="IdHuesped" />

            <partial name="_Formulario" model="Model" />

            <button type="submit" class="btn btn-primary">
                Guardar cambios
            </button>

            <a asp-action="Index" class="btn btn-outline-secondary">
                Cancelar
            </a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
@model HuespedFormularioViewModel

<div asp-validation-summary="ModelOnly"
     class="text-danger mb-3"></div>

<div class="mb-3">
    <label asp-for="NombreHuesped" class="form-label"></label>

    <input asp-for="NombreHuesped"
           class="form-control"
           maxlength="100" />

    <span asp-validation-for="NombreHuesped"
          class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Celular" class="form-label"></label>

    <input asp-for="Celular"
           type="tel"
           class="form-control"
           maxlength="16   " />

    <span asp-validation-for="Celular"
          class="text-danger"></span>
</div>
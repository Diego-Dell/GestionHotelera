@model GestionHotelera.Models.ReservaServicio
@{
    ViewData["Title"] = "Quitar Servicio";
}

<h1>Quitar Servicio</h1>
<h3>¿Estás seguro que deseas quitar este servicio de la reserva?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Reserva ID</dt>
        <dd class="col-sm-10">@Model.IdReserva</dd>
        <dt class="col-sm-2">Servicio</dt>
        <dd class="col-sm-10">@Model.Servicio.Nombre</dd>
        <dt class="col-sm-2">Fecha</dt>
        <dd class="col-sm-10">@Model.Fecha.ToShortDateString()</dd>
    </dl>
    <form asp-action="Delete">
        <input type="hidden" asp-for="IdReserva" />
        <input type="hidden" asp-for="IdServicio" />
        <input type="submit" value="Quitar" class="btn btn-danger" /> |
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>
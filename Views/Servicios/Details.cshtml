@model Servicio
@{ ViewData["Title"] = "Detalle de servicio"; }
<h1>Detalle de servicio</h1>
<dl class="row">    <dt class="col-sm-3">Nombre</dt><dd class="col-sm-9">@Model.Nombre</dd>
    <dt class="col-sm-3">Precio</dt><dd class="col-sm-9">@Model.Precio</dd></dl>
<a asp-action="Edit" asp-route-id="@Model.IdServicio" class="btn btn-primary">Editar</a>
<a asp-action="Index" class="btn btn-outline-secondary">Volver</a>
